# Database (Neon). For local use, DIRECT_URL can be the same as DATABASE_URL.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Razorpay (use TEST keys while developing)
RAZORPAY_KEY_ID=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Brevo SMTP example)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="orders@yourstore.com"

# Protects /api/cron/expire-orders (any long random string)
CRON_SECRET=""

# Optional: set to "1" to make every admin use two-factor login (a code from an authenticator app)
ADMIN_REQUIRE_2FA=""

# Optional: key that protects two-factor secrets in the database (defaults to NEXTAUTH_SECRET)
TWO_FACTOR_KEY=""

# Optional: send error alerts to Slack, Discord or Google Chat (a webhook link). If empty, alerts are emailed to your contact email.
ALERT_WEBHOOK_URL=""

# Optional: used by prisma/seed.ts for your first admin login
ADMIN_EMAIL="admin@yourstore.com"
ADMIN_PASSWORD="ChangeThisPassword123"
